# Source-only publication. Existing local files remain untouched.
# Deny everything at the workspace root, then allow only project sources.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTINUAR_FIFA_STREET_2*.md
!/INSTRUCAO_CONTINUAR_FIFA_STREET_2_ATE_FINALIZAR.md
# Continuation prompts stay local; never publish them.
/PROMPT*.txt

!/docs/
/docs/*
!/docs/*.md

!/fifa_pc/
/fifa_pc/*
!/fifa_pc/*.csproj
!/fifa_pc/*.cs
!/fifa_pc/README.md
!/fifa_pc/Runtime/
/fifa_pc/Runtime/**
!/fifa_pc/Runtime/**/
!/fifa_pc/Runtime/**/*.cs

!/pc_compat/
/pc_compat/*
!/pc_compat/*.csproj
!/pc_compat/*.cs
!/pc_compat/README.md
!/pc_compat/Runtime/
/pc_compat/Runtime/**
!/pc_compat/Runtime/**/
!/pc_compat/Runtime/**/*.cs

!/tools/
/tools/*
!/tools/*.ps1
!/tools/analysis/
/tools/analysis/*
!/tools/analysis/*.py
!/tools/tests/
/tools/tests/*
!/tools/tests/*.py

!/native_recomp/
/native_recomp/*
