# Source-only publication. Existing local files remain untouched.
# Deny everything at the workspace root, then allow only project sources.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTINUAR_FIFA_STREET_2*.md
!/INSTRUCAO_CONTINUAR_FIFA_STREET_2_ATE_FINALIZAR.md
!/PROMPT_CONTINUAR_FIFA_STREET_2*.txt

!/docs/
/docs/*
!/docs/*.md

!/fifa_pc/
/fifa_pc/*
!/fifa_pc/*.csproj
!/fifa_pc/README.md
!/fifa_pc/Runtime/
/fifa_pc/Runtime/**
!/fifa_pc/Runtime/**/
!/fifa_pc/Runtime/**/*.cs

!/pc_compat/
/pc_compat/*
!/pc_compat/*.csproj
!/pc_compat/README.md
!/pc_compat/Runtime/
/pc_compat/Runtime/**
!/pc_compat/Runtime/**/
!/pc_compat/Runtime/**/*.cs

!/tools/
/tools/*
!/tools/*.ps1
!/tools/analysis/
/tools/analysis/*
!/tools/analysis/*.py
!/tools/tests/
/tools/tests/*
!/tools/tests/*.py

# Defense in depth: never publish original game media, extracted payloads,
# generated reports, credentials, build output or unrelated projects.
**/bin/
**/obj/
**/__pycache__/
**/.venv/
**/node_modules/
**/.env
**/.env.*
*.iso
*.xbe
*.big
*.bh
*.ord
*.orl
*.o
*.xsh
*.xbx
*.ast
*.abk
*.bnk
*.evt
*.wav
*.mp3
*.ogg
*.ppm
*.png
*.tga
*.jpg
*.zip
*.7z
*.exe
*.dll
*.pdb
*.pyc
*.tsv
*.csv
*.log
*.pem
*.key
