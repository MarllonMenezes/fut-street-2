diff --git a/tools/recomp/test_lifter_pcrtc_ack.py b/tools/recomp/test_lifter_pcrtc_ack.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_lifter_pcrtc_ack.py
@@ -0,0 +1,23 @@
+"""Route only the observed dword PCRTC displacement form to a checked host service."""
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+def lower(dst, src=None):
+    return '\n'.join(Lifter().lift_instruction(Instruction(0x100,6,'mov','','',
+        operands=[dst,src or Operand(type='reg',reg='ecx')])))
+
+def test_dword_displacement_routes_register_and_immediate_sources():
+    dst=Operand(type='mem',mem_base='edi',mem_disp=0x600100,mem_size=4)
+    assert 'recomp_xbox_pcrtc_store32((uint32_t)(edi + 0x600100), ecx)' in lower(dst)
+    assert 'recomp_xbox_pcrtc_store32' in lower(dst,Operand(type='imm',imm=1))
+
+def test_other_stores_remain_ordinary_memory():
+    for overrides in ({'mem_size':1},{'mem_size':2},{'mem_disp':0x600140},
+                      {'mem_index':'ecx'},{'mem_seg':'fs'},{'mem_base':None}):
+        fields=dict(type='mem',mem_base='edi',mem_disp=0x600100,mem_size=4)
+        fields.update(overrides)
+        assert 'recomp_xbox_pcrtc_store32' not in lower(Operand(**fields))
+
+def test_matching_load_is_not_a_store():
+    src=Operand(type='mem',mem_base='edi',mem_disp=0x600100,mem_size=4)
+    assert 'recomp_xbox_pcrtc_store32' not in lower(Operand(type='reg',reg='eax'),src)
