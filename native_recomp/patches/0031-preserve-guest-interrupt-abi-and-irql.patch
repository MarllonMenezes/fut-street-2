+#ifndef XBOX_IRQ_CONTRACT_H
+#define XBOX_IRQ_CONTRACT_H
+#include <stdint.h>
+/* Guest ABI constants; not host structure sizes or a hardware dispatcher. */
+#define XBOX_BUS_IRQ_MAX 27u
+#define XBOX_DEVICE_VECTOR_BASE 0x30u
+#define XBOX_GUEST_KINTERRUPT_SIZE 0x70u
+static inline uint32_t xbox_BusInterruptVector(uint32_t bus)
+{
+    return bus<=XBOX_BUS_IRQ_MAX?XBOX_DEVICE_VECTOR_BASE+bus:0;
+}
+static inline uint8_t xbox_BusInterruptIrql(uint32_t bus)
+{
+    return (uint8_t)(XBOX_BUS_IRQ_MAX-bus); /* caller validates bus first */
+}
+#endif
