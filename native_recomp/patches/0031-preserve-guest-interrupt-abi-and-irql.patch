+#ifdef FUT_NATIVE_INTERRUPT_GATES
+/* Caller owns a guest execution context and an active host interrupt gate.
+ * No pending register bits are fabricated here. -2 means not delivered,
+ * -1 invalid/unresolved, 0 declined, 1 claimed. DPC draining is separate. */
+int xbox_InvokeConnectedInterrupt(uint32_t bus)
+{
+    if (!fut_guest_interrupt_scope_active()) return -2;
+    if (!g_fs_base || !g_esp || !bridge_va_mapped(g_fs_base,0x28)
+            || g_esp<12 || !bridge_va_mapped(g_esp-12,16)) return -1;
+    uint32_t before=g_esp;
+    int result=kernel_raise_interrupt(bus);
+    if (g_esp!=before) return -1;
+    return result;
+}
+#endif
