@@ -164,0 +165,11 @@ class FunctionDetector:
+        # Data-pointer and seed aliases are materialised after the original
+        # tail-jump pass. Their bodies can themselves end in a tail jump into
+        # an existing function, so run the pass again with those entries now
+        # visible as owners. Rebuild until no new candidate/alias is found.
+        for _round in range(8):
+            if not self._pass_tail_jump_targets(sections):
