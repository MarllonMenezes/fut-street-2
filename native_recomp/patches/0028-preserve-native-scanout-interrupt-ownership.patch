+#ifndef XBOX_NV2A_ACK_OWNERSHIP_H
+#define XBOX_NV2A_ACK_OWNERSHIP_H
+#include <stdint.h>
+/* Native scanout must retain pending status until an explicit translated
+ * acknowledgement. This does not implement W1C or produce interrupts. */
+static inline uint32_t xbox_Nv2aLegacyAckMask(uint32_t offset,uint32_t mask,
+                                           int external_graphics_completion)
+{
+    if(external_graphics_completion && (offset==0x000100u || offset==0x600100u))
+        return 0;
+    return mask;
+}
+#endif
