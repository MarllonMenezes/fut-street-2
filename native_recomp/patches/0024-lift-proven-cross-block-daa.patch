+    def test_title_cross_block_daa_requires_the_exact_table_arm(self):
+        def insn(address, mnemonic, op_str=""):
+            item = self._insn(mnemonic, op_str=op_str)
+            item.address = address
+            return item
+
+        exact = [
+            insn(0x00270E87, "cmp", "ecx, 4"),
+            insn(0x00270E8C, "and", "eax, 3"),
+            insn(0x00270E8F, "sub", "ecx, eax"),
+            insn(0x00270E91, "jmp", "dword ptr [eax*4 + 0x270e9c]"),
+            insn(0x00270E98, "jmp", "dword ptr [ecx*4 + 0x270f98]"),
+            insn(0x00270E9F, "nop"),
+            insn(0x00270EA0, "lodsb"),
+            insn(0x00270EA1, "push", "cs"),
+            insn(0x00270EA2, "daa"),
+        ]
+        self.assertEqual(
+            FunctionTranslator._supported_title_cross_block_decimal_adjust_sites(
+                exact
