+        altered = list(exact)
+        altered[3] = insn(0x00270E91, "jmp", "dword ptr [eax*4 + 0x270ea0]")
+        self.assertEqual(
+            FunctionTranslator._supported_title_cross_block_decimal_adjust_sites(
