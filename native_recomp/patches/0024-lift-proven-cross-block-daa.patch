+    @staticmethod
+    def _supported_title_cross_block_decimal_adjust_sites(instructions):
+        """Recover the one title-specific DAA arm with bounded flag proof.
+
+        The remaining DAA in this image is reached through two indirect jump
+        tables.  Both incoming arms define CF/AF first (``cmp`` or ``sub``),
+        and the shared arm contains only ``nop; lodsb; push cs`` before DAA;
+        those instructions do not modify either flag.  Keep this proof tied
+        to the exact observed addresses and operands so a different table
+        shape remains untranslated instead of inheriting a guessed flag state.
+        """
+        by_address = {insn.address: insn for insn in instructions}
+
+        def matches(address, mnemonic, operand_fragment=None):
+            insn = by_address.get(address)
+            if insn is None or insn.mnemonic != mnemonic:
+                return False
+            if operand_fragment is None:
+                return True
+            normalized = " ".join(insn.op_str.lower().split())
+            return operand_fragment in normalized
+
+        shape = (
+            matches(0x00270E87, "cmp", "ecx, 4")
+            and matches(0x00270E8C, "and", "eax, 3")
+            and matches(0x00270E8F, "sub", "ecx, eax")
+            and matches(0x00270E91, "jmp", "[eax*4 + 0x270e9c]")
+            and matches(0x00270E98, "jmp", "[ecx*4 + 0x270f98]")
+            and matches(0x00270E9F, "nop")
+            and matches(0x00270EA0, "lodsb")
+            and matches(0x00270EA1, "push", "cs")
+            and matches(0x00270EA2, "daa")
+        )
+        return {0x00270EA2} if shape else set()
+
