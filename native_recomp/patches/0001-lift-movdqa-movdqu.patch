+++ b/tools/recomp/test_lifter_sse.py
@@ -49,0 +50,14 @@ class SsePackedLifterTest(unittest.TestCase):
+    def test_integer_packed_moves_preserve_all_128_bits(self):
+        self.assertEqual(
+            Lifter().lift_instruction(
+                _insn("movdqa", "xmm0, xmmword ptr [eax]",
+                      [_xmm("xmm0"), _mem("eax")])),
+            ["xmm0 = XMM_MEM(eax); /* movdqa */"],
+        )
+        self.assertEqual(
+            Lifter().lift_instruction(
+                _insn("movdqu", "xmmword ptr [ecx], xmm1",
+                      [_mem("ecx"), _xmm("xmm1")])),
+            ["XMM_STORE(ecx, xmm1); /* movdqu */"],
+        )
