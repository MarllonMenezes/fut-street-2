diff --git a/tools/recomp/test_lifter_cpuid_barrier.py b/tools/recomp/test_lifter_cpuid_barrier.py
new file mode 100644
index 0000000..c5f912a
--- /dev/null
+++ b/tools/recomp/test_lifter_cpuid_barrier.py
@@ -0,0 +1,48 @@
+"""Only a proven timestamp CPUID pattern may lower to a barrier."""
+import unittest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+from .translator import FunctionTranslator
+
+
+def _insn(address, mnemonic, operands=()):
+    return Instruction(address, 1, mnemonic, "", "", operands=list(operands))
+
+
+def _reg(name):
+    return Operand(type="reg", reg=name)
+
+
+def _mem():
+    return Operand(type="mem", mem_base="ebp", mem_disp=-4, mem_size=4)
+
+
+class CpuidBarrierTest(unittest.TestCase):
+    def test_timestamp_pattern_proves_cpuid_outputs_are_discarded(self):
+        insns = [
+            _insn(0x100, "pushal"),
+            _insn(0x101, "cpuid"),
+            _insn(0x102, "rdtsc"),
+            _insn(0x103, "mov", [_mem(), _reg("eax")]),
+            _insn(0x104, "popal"),
+        ]
+        self.assertEqual(
+            FunctionTranslator._supported_cpuid_sites(insns), {0x101})
+
+    def test_unproven_cpuid_stays_runtime_visible(self):
+        lifter = Lifter()
+        out = lifter.lift_instruction(_insn(0x200, "cpuid"))
+        self.assertIn("RECOMP_UNIMPL", " ".join(out))
+        self.assertNotIn(0x200, lifter.supported_cpuid_sites)
+
+    def test_proven_cpuid_emits_only_the_barrier(self):
+        lifter = Lifter()
+        lifter.supported_cpuid_sites = {0x300}
+        out = " ".join(lifter.lift_instruction(_insn(0x300, "cpuid")))
+        self.assertIn("RECOMP_CPUID_BARRIER()", out)
+        self.assertNotIn("RECOMP_UNIMPL", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/recomp/test_lifter_flag_save_pair.py b/tools/recomp/test_lifter_flag_save_pair.py
