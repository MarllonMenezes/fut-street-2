+++ b/tools/recomp/test_lifter_flag_save_pair.py
@@ -0,0 +1,47 @@
+"""The one proven dead PUSHFD/POPFD pair may remain stack-neutral."""
+import unittest
+
+from .disasm import Instruction
+from .lifter import Lifter
+from .translator import FunctionTranslator
+
+
+def _insn(address, mnemonic):
+    return Instruction(address, 1, mnemonic, "", "")
+
+
+class FlagSavePairTest(unittest.TestCase):
+    def test_helper_call_pair_is_proven_dead(self):
+        insns = [
+            _insn(0x100, "pushfd"),
+            _insn(0x101, "push"),
+            _insn(0x102, "call"),
+            _insn(0x103, "add"),
+            _insn(0x104, "popfd"),
+            _insn(0x105, "popal"),
+        ]
+        self.assertEqual(
+            FunctionTranslator._supported_flag_save_sites(insns),
+            {0x100, 0x104})
+
+    def test_pair_with_a_branch_is_not_proven(self):
+        insns = [
+            _insn(0x200, "pushfd"),
+            _insn(0x201, "push"),
+            _insn(0x202, "je"),
+            _insn(0x203, "popfd"),
+            _insn(0x204, "popal"),
+        ]
+        self.assertEqual(FunctionTranslator._supported_flag_save_sites(insns), set())
+
+    def test_proven_sites_emit_no_unimplemented_marker(self):
+        lifter = Lifter()
+        lifter.supported_flag_save_sites = {0x300, 0x304}
+        self.assertNotIn("RECOMP_UNIMPL", " ".join(
+            lifter.lift_instruction(_insn(0x300, "pushfd"))))
+        self.assertNotIn("RECOMP_UNIMPL", " ".join(
+            lifter.lift_instruction(_insn(0x304, "popfd"))))
+
+
+if __name__ == "__main__":
+    unittest.main()
