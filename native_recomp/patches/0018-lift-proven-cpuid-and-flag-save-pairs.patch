+    @staticmethod
+    def _supported_cpuid_sites(instructions):
+        """Allow only CPUID whose leaves are overwritten before any read.
+
+        The current title has one site in a timestamp helper:
+        ``pushad; cpuid; rdtsc; mov [frame], eax; popad``.  The CPUID
+        outputs are therefore not observable, while its serialization before
+        RDTSC still matters to the translated memory/time ordering.  Keep
+        other CPUID forms unresolved instead of guessing an Xbox CPUID leaf.
+        """
+        supported = set()
+        for index, insn in enumerate(instructions):
+            if insn.mnemonic != "cpuid" or index == 0:
+                continue
+            if instructions[index - 1].mnemonic not in ("pushad", "pushal"):
+                continue
+            if index + 3 >= len(instructions):
+                continue
+            rdtsc, store, restore = instructions[index + 1:index + 4]
+            if rdtsc.mnemonic != "rdtsc":
+                continue
+            if (store.mnemonic != "mov" or len(store.operands) != 2
+                    or store.operands[0].type != "mem"
+                    or store.operands[1].type != "reg"
+                    or store.operands[1].reg != "eax"):
+                continue
+            if restore.mnemonic not in ("popad", "popal"):
+                continue
+            supported.add(insn.address)
+        return supported
+
+    @staticmethod
+    def _supported_flag_save_sites(instructions):
+        """Find the exact dead PUSHFD/POPFD helper-call idiom.
+
+        The saved word stays below one pushed argument and one call frame;
+        ``add esp, 4; popfd; popad`` then removes it before a back-edge to a
+        fresh compare.  Requiring this shape avoids pretending to implement
+        arbitrary EFLAGS serialization.
+        """
+        supported = set()
+        for index, insn in enumerate(instructions):
+            if insn.mnemonic != "pushfd":
+                continue
+            window = instructions[index:index + 8]
+            try:
+                pop_index = next(
+                    offset for offset, candidate in enumerate(window[1:], 1)
+                    if candidate.mnemonic == "popfd")
+            except StopIteration:
+                continue
+            before = window[1:pop_index]
+            if not before or before[0].mnemonic != "push":
+                continue
+            if not any(candidate.mnemonic == "call" for candidate in before):
+                continue
+            if any(candidate.is_branch or candidate.is_ret
+                   for candidate in before):
+                continue
+            after = window[pop_index + 1:]
+            if not after or after[0].mnemonic not in ("popad", "popal"):
+                continue
+            supported.update((insn.address, window[pop_index].address))
+        return supported
+
