-
+
+/* Packed 16-bit integer operations use all eight XMM word lanes. */
+#define RECOMP_XMM_WORD_BINOP(NAME, EXPR)                               \
+    static inline RecompXmm NAME(RecompXmm a, RecompXmm b) {            \
+        RecompXmm r; int i;                                             \
+        for (i = 0; i < 8; i++) r.w[i] = (EXPR);                       \
+        return r;                                                       \
+    }
+RECOMP_XMM_WORD_BINOP(XMM_PADDW,
+    (int16_t)((uint16_t)a.w[i] + (uint16_t)b.w[i]))
+RECOMP_XMM_WORD_BINOP(XMM_PSUBW,
+    (int16_t)((uint16_t)a.w[i] - (uint16_t)b.w[i]))
+RECOMP_XMM_WORD_BINOP(XMM_PMULHUW,
+    (uint16_t)(((uint32_t)a.uw[i] * (uint32_t)b.uw[i]) >> 16))
+static inline RecompXmm XMM_PSRAW(RecompXmm a, uint64_t count) {
+    RecompXmm r;
+    int i;
+    int32_t shift = (count >= 16) ? 15 : (int32_t)count;
+    int32_t mask = (1 << shift) - 1;
+    for (i = 0; i < 8; i++) {
+        int32_t value = a.w[i];
+        r.w[i] = (int16_t)(value >= 0
+            ? (value >> shift)
+            : -(((-value) + mask) >> shift));
+    }
+    return r;
+}
