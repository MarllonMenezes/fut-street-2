@@ -1407,6 +1407,41 @@ class FunctionTranslator:
         return any(insn.mnemonic in ("daa", "das", "lahf")
                    for insn in instructions)
 
+    @staticmethod
+    def _supported_decimal_adjust_sites(instructions):
+        """Keep DAA/DAS untranslated until this function has defined CF."""
+        cf_writers = {
+            "add", "sub", "cmp", "test", "and", "or", "xor", "adc", "sbb",
+            "shl", "shr", "sar", "neg", "imul", "stc", "clc", "cmc",
+            "rcl", "rcr", "bt", "bts", "btr", "btc", "cmpxchg", "xadd",
+            "daa", "das",
+        }
+        from .lifter import _is_rep_compare
+
+        addresses = {insn.address for insn in instructions}
+        leaders = set()
+        if instructions:
+            leaders.add(instructions[0].address)
+        for index, insn in enumerate(instructions):
+            if insn.is_branch:
+                target = insn.jump_target
+                if target in addresses:
+                    leaders.add(target)
+            if (insn.is_branch or insn.is_call or insn.is_ret) and index + 1 < len(instructions):
+                leaders.add(instructions[index + 1].address)
+
+        seen_cf_definition = False
+        supported = set()
+        for insn in instructions:
+            if insn.address in leaders:
+                seen_cf_definition = False
+            if insn.mnemonic in ("daa", "das"):
+                if seen_cf_definition:
+                    supported.add(insn.address)
+            elif insn.mnemonic in cf_writers or _is_rep_compare(insn):
+                seen_cf_definition = True
+        return supported
+
     def _func_has_prologue(self, instructions):
