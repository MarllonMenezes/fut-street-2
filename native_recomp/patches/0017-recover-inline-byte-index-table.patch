+def test_inline_data_range_redecodes_and_drops_overlapping_stream():
+    # The byte table is 0D 08. Linear decoding treats those bytes plus the
+    # first three bytes of MOV as an `or`-family instruction, then starts an
+    # `add al, imm8` inside the real MOV. A proven data range resyncs at +3.
+    code = bytes.fromhex("c3" "0d08" "8b442404" "a3f4fe3400" "c3")
+    insns = Disassembler().disassemble_function(
+        code, BASE, BASE + len(code),
+        data_ranges=[(BASE + 1, BASE + 3)],
+    )
+    starts = [insn.address - BASE for insn in insns]
+    assert 3 in starts and 7 in starts and 12 in starts
+    assert 6 not in starts
+    assert [insn.mnemonic for insn in insns if 3 <= insn.address - BASE < 12] == [
+        "mov", "mov",
+    ]
