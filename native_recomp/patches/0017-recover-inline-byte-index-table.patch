+def test_guarded_movzx_byte_index_table_after_pointer_table_is_data():
+    # cmp eax, 3; ja default; movzx eax, byte ptr [eax + INDEX_TABLE];
+    # jmp dword ptr [eax*4 + POINTER_TABLE]. The bounded byte map follows the
+    # measured code-pointer table and must not become decoded instructions.
+    # A direct call proves the compact table's end even though the linear
+    # sweep decodes across the last table bytes and misses that boundary.
+    index_table = BASE + 104
+    pointer_table = BASE + 48
+    index_end = index_table + 24
+    data = bytearray(b"\xE8" + struct.pack("<i", index_end - (BASE + 5)))
+    data += b"\x90" * 3
+    data += b"\x83\xF8\x17\x77\x1D"
+    data += b"\x0F\xB6\x80" + struct.pack("<I", index_table)
+    data += b"\xFF\x24\x85" + struct.pack("<I", pointer_table)
+    arm0 = BASE + len(data)
+    data += b"\x31\xC0\xC3"
+    arm1 = BASE + len(data)
+    data += b"\xB8\x01\x00\x00\x00\xC3"
+    arm2 = BASE + len(data)
+    data += b"\xB8\x02\x00\x00\x00\xC3"
+    arm3 = BASE + len(data)
+    data += b"\x31\xC0\xC3"
+    data += b"\x90" * (pointer_table - BASE - len(data))
+    pointer_targets = (arm0, arm1, arm2, arm3) * 4
+    data += struct.pack("<14I", *pointer_targets[:14])
+    data += bytes((0, 1, 2, 3, 4, 5, 6, 5, 6, 7, 7, 8,
+                   8, 9, 7, 8, 8, 10, 11, 9, 12, 8, 13, 8))
+    data += b"\x8B\x44\x24\x04\xA3\xF4\xFE\x34\x00\xC3"
+
+    engine, _image = _engine(bytes(data) + b"\xCC" * 16)
+
+    assert engine.jump_tables[pointer_table] == index_table
+    assert engine.index_tables[index_table] == index_end
+    assert all(engine.get_instruction(addr) is None
+               for addr in range(index_table, index_end))
+    assert engine.get_instruction(index_end).mnemonic == "mov"
+    assert engine.get_instruction(index_end + 4).mnemonic == "mov"
+    assert engine.get_instruction(index_end + 3) is None
