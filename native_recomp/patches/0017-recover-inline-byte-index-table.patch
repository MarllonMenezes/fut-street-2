+    def _adjacent_index_table_end(self, jump_table: int, table_end: int,
+                                  jump_entries: int) -> Optional[int]:
+        """Measure a compact byte table only from a guarded MOVZX dispatch.
+
+        Accept the sequence `cmp reg, imm; ja default; movzx reg, byte ptr
+        [reg + table_end]; jmp [reg*4 + jump_table]`. The inclusive bound
+        supplies the exact size; each byte must select a measured pointer
+        entry, and the end must already be a decoded instruction boundary.
+        """
+        for dispatch in self.instructions.values():
+            if not dispatch.is_jump or dispatch.jump_table != jump_table:
+                continue
+            before_dispatch = self.get_instructions_in_range(
+                max(0, dispatch.address - 16), dispatch.address
+            )
+            if not before_dispatch:
+                continue
+            load = before_dispatch[-1]
+            if (load.end_address != dispatch.address
+                    or load.byte_table_ref != table_end
+                    or load.byte_table_dest_reg is None
+                    or load.byte_table_dest_reg != dispatch.jump_table_index_reg):
+                continue
+            before_load = self.get_instructions_in_range(
+                max(0, load.address - 8), load.address
+            )
+            if not before_load:
+                continue
+            guard = before_load[-1]
+            before_guard = self.get_instructions_in_range(
+                max(0, guard.address - 8), guard.address
+            )
+            if not before_guard:
+                continue
+            compare = before_guard[-1]
+            if (compare.end_address != guard.address
+                    or not guard.is_cond_jump or guard.mnemonic != "ja"
+                    or guard.end_address != load.address
+                    or compare.compare_reg != load.byte_table_base_reg
+                    or compare.compare_imm is None
+                    or compare.compare_imm >= 256):
+                continue
+
+            length = compare.compare_imm + 1
+            end = table_end + length
+            section = self.image.get_section_at_va(table_end)
+            boundary_is_known = end in self.instructions or any(
+                insn.call_target == end or insn.jump_target == end
+                for insn in self.instructions.values()
+            )
+            if (section is None
+                    or end > section.virtual_addr + section.virtual_size
+                    or not boundary_is_known):
+                continue
+            values = self.image.read_bytes_at_va(table_end, length)
+            if (values is None or len(values) != length
+                    or any(value >= jump_entries for value in values)):
+                continue
+            if any(
+                    not (jump_table <= insn.address < table_end)
+                    and (
+                    (insn.call_target is not None
+                     and table_end <= insn.call_target < end)
+                    or (insn.jump_target is not None
+                        and table_end <= insn.jump_target < end))
+                    for insn in self.instructions.values()):
+                continue
+            return end
+        return None
+
+    def _decode_from_proven_entry(self, addr: int,
+                                  max_insns: int = 64) -> int:
+        """Re-decode a bounded stream from a directly referenced code entry.
+
+        A linear sweep through an adjacent byte table can leave instruction
+        starts overlapping the first real instruction after the table. This
+        routine trusts only the already-proven entry, replaces conflicting
+        decodes until the new stream reaches an identical existing instruction,
+        and then stops to preserve any other x86 overlapping streams.
+        """
+        section = self.image.get_section_at_va(addr)
+        if section is None or not section.executable:
+            return 0
+        data = self.image.get_section_data(section)
+        offset = addr - section.virtual_addr
+        if offset < 0 or offset >= len(data):
+            return 0
+
+        decoded_count = 0
+        for decoded in self._cs.disasm(data[offset:], addr):
+            if decoded_count >= max_insns:
+                break
+            replacement = self._classify_instruction(decoded)
+            existing = self.instructions.get(decoded.address)
+            if (decoded.address != addr and existing is not None
+                    and existing.size == replacement.size
+                    and existing.mnemonic == replacement.mnemonic
+                    and existing.bytes_hex == replacement.bytes_hex):
+                break
+
+            overlap_start = max(section.virtual_addr,
+                                decoded.address - 15)
+            for old in self.get_instructions_in_range(
+                    overlap_start, decoded.address + decoded.size):
+                if (old.address != decoded.address
+                        and old.end_address > decoded.address):
+                    del self.instructions[old.address]
+            self.instructions[decoded.address] = replacement
+            self._sorted_addrs = None
+            decoded_count += 1
+            if replacement.is_terminator:
+                break
+        return decoded_count
+
     def jump_table_entries(self, tbl: int) -> List[int]:
         """Code pointers held by a resynced jump table, or [] if unknown."""
         tbl = self._jt_base.get(tbl, tbl)
