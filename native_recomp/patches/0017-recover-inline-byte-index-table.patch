diff --git a/tools/recomp/test_disasm_resync_interior.py b/tools/recomp/test_disasm_resync_interior.py
index f612aa5..bf2bc5b 100644
--- a/tools/recomp/test_disasm_resync_interior.py
+++ b/tools/recomp/test_disasm_resync_interior.py
@@ -38,3 +38,20 @@ def test_no_misaligned_instruction_survives_inside_the_arm():
     assert [i.address - BASE for i in insns if 2 <= i.address - BASE < 10] == [2, 6]
     mnemonics = {i.mnemonic for i in insns if BASE + 2 <= i.address < BASE + 10}
     assert "inc" not in mnemonics and "pop" not in mnemonics
+
