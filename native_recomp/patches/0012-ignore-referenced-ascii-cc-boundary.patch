+    def _is_referenced_ascii_data(self, addr: int) -> bool:
+        """Reject a CC-boundary candidate proven to be referenced string data.
+
+        This is intentionally narrow: an exact DATA_IMM reference plus a
+        printable NUL-terminated byte run is required, and any direct control
+        flow reference keeps the function candidate. It only vetoes the weak
+        CC-padding heuristic; call/jump/seed candidates use their own evidence.
+        """
+        refs = self.xrefs.get_refs_to(addr)
+        if not any(ref.xref_type == XRefType.DATA_IMM for ref in refs):
+            return False
+        if any(ref.xref_type in (XRefType.CALL, XRefType.JUMP,
+                                 XRefType.COND_JUMP) for ref in refs):
+            return False
+
+        data = self.image.read_bytes_at_va(addr, 128)
+        if not data:
+            return False
+        end = data.find(b"\0")
+        if end < 8:
+            return False
+        return all(0x20 <= byte < 0x7F or byte in (0x09, 0x0A, 0x0D)
+                   for byte in data[:end])
+
