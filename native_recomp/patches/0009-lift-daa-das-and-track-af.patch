diff --git a/tools/recomp/test_lifter_daa_das.py b/tools/recomp/test_lifter_daa_das.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_lifter_daa_das.py
@@ -0,0 +1,59 @@
+import unittest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter, _make_condition
+from .translator import FunctionTranslator
+
+
+class DaaDasLifterTest(unittest.TestCase):
+    @staticmethod
+    def _insn(mnemonic, operands=None, op_str=""):
+        insn = Instruction(0x1000, 1, mnemonic, op_str, "90")
+        insn.operands = list(operands or [])
+        return insn
+
+    def test_daa_and_das_consume_and_update_cf_af_and_al(self):
+        for mnemonic in ("daa", "das"):
+            lifter = Lifter()
+            lifter.needs_cf = True
+            lifter.needs_af = True
+            generated = "\n".join(lifter.lift_instruction(self._insn(mnemonic)))
+            self.assertIn("_old_cf = _cf", generated)
+            self.assertIn("|| _af", generated)
+            self.assertIn("_cf = _cf_out; _af = _af_out", generated)
+            self.assertIn("SET_LO8(eax, _al)", generated)
+            self.assertIn("_fa = _al", generated)
+
+    def test_daa_das_conditions_use_adjusted_al_and_parity(self):
+        for mnemonic in ("daa", "das"):
+            self.assertEqual(_make_condition("je", mnemonic, [])[0], "(_fa == 0)")
+            self.assertEqual(_make_condition("js", mnemonic, [])[0], "(_fas < 0)")
+            self.assertIn("0x6996u", _make_condition("jp", mnemonic, [])[0])
+            self.assertIsNone(_make_condition("jo", mnemonic, []))
+
+    def test_all_arithmetic_writers_needed_by_daa_produce_af(self):
+        af_users = ("daa", "lahf")
+        self.assertTrue(FunctionTranslator._function_needs_af(
+            [self._insn("add"), self._insn("daa")]))
+        self.assertTrue(FunctionTranslator._function_needs_af(
+            [self._insn("lahf")]))
+        self.assertFalse(FunctionTranslator._function_needs_af(
+            [self._insn("add")]))
+
+        lifter = Lifter()
+        lifter.needs_af = True
+        al = Operand(type="reg", reg="al")
+        imm = Operand(type="imm", imm=1)
+        for mnemonic in ("add", "sub"):
+            generated = "\n".join(lifter.lift_instruction(
+                self._insn(mnemonic, [al, imm], "al, 1")))
+            self.assertIn("_af =", generated)
+
+    def test_function_declares_both_flags_for_daa_lahf_consumers(self):
+        insns = [self._insn("add"), self._insn("daa"), self._insn("lahf")]
+        self.assertTrue(FunctionTranslator._function_needs_af(insns))
+        self.assertTrue(FunctionTranslator._function_needs_cf(insns))
+
+
+if __name__ == "__main__":
+    unittest.main()
