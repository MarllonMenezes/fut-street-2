+
+def test_tail_alias_backward_branch_into_common_parent_creates_entry():
+    parent = Function(0x1000, 0x1060, "parent")
+    tail_alias = Function(0x1038, 0x1060, "tail_alias")
+    detector = make_detector(
+        [parent, tail_alias], 0x1020, branch_source=0x1044,
+    )
+
+    assert detector._pass_cond_branch_interior_aliases()
+    assert detector._alias_entries == {0x1020: 0x1060}
