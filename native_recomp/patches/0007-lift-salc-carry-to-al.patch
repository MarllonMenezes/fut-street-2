@@ -8,0 +9,34 @@
+    def test_salc_maps_carry_to_low_accumulator_byte(self):
+        stc = Instruction(0, 1, "stc", "", "f9")
+        stc.operands = []
+        salc = Instruction(1, 1, "salc", "", "d6")
+        salc.operands = []
+        lifter = Lifter()
+        lifter.needs_cf = True
+
+        lifted, _ = lift_basic_block(
+            lifter, BasicBlock(start=0, instructions=[stc, salc]))
+        generated = "\n".join(lifted)
+
+        self.assertIn("_cf = 1; /* stc */", generated)
+        self.assertIn(
+            "SET_LO8(eax, _cf ? 0xFFu : 0u); /* salc: AL = CF ? 0xFF : 0 */",
+            generated,
+        )
+    def test_salc_clears_low_accumulator_byte_when_carry_clear(self):
+        clc = Instruction(0, 1, "clc", "", "f8")
+        clc.operands = []
+        salc = Instruction(1, 1, "salc", "", "d6")
+        salc.operands = []
+        lifter = Lifter()
+        lifter.needs_cf = True
+
+        lifted, _ = lift_basic_block(
+            lifter, BasicBlock(start=0, instructions=[clc, salc]))
+        generated = "\n".join(lifted)
+
+        self.assertIn("_cf = 0; /* clc */", generated)
+        self.assertIn(
+            "SET_LO8(eax, _cf ? 0xFFu : 0u); /* salc: AL = CF ? 0xFF : 0 */",
+            generated,
+        )
