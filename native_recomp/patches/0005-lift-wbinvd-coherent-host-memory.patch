diff --git a/tools/recomp/lifter.py b/tools/recomp/lifter.py
index 0000000..0000000 100644
--- a/tools/recomp/lifter.py
+++ b/tools/recomp/lifter.py
@@ -1653,6 +1653,13 @@ class Lifter:
         # Cache hints and store fences: nothing to model on a single-threaded
         # interpreter over coherent host memory. Named so they stop showing up
         # in the unimplemented report as if they were missing work.
+        # WBINVD is different: it is serializing and writes dirty cache lines
+        # back before invalidating them. The translated program has no separate
+        # guest CPU cache, so preserve the guest-memory ordering on the coherent
+        # host and leave device/DMA cache maintenance to an explicit backend.
+        if m == "wbinvd":
+            return ["RECOMP_WBINVD(); /* wbinvd: host-coherent memory only */"]
+
         if m.startswith("prefetch") or m in ("sfence", "lfence", "mfence"):
             return [f"(void)0; /* {m}: cache/ordering hint, nothing to model */"]
 
diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
index 0000000..0000000 100644
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -44,7 +44,17 @@
 #ifndef RECOMP_TYPES_H
 #define RECOMP_TYPES_H
 
 #include <stdint.h>
 #include <stddef.h>
 #include <string.h>
+#include <stdatomic.h>
+
+/* A statically recompiled guest has no private CPU data cache separate from
+ * the host's coherent memory system. A sequentially-consistent host fence
+ * preserves ordering of translated CPU memory operations at WBINVD sites.
+ * This does NOT flush host cache lines and is not a DMA/device visibility
+ * operation; any native device backend must perform its own resource flush.
+ */
+#define RECOMP_WBINVD() atomic_thread_fence(memory_order_seq_cst)
+
 /* math.h is load-bearing, and its absence was invisible.

diff --git a/tools/recomp/test_lifter_wbinvd.py b/tools/recomp/test_lifter_wbinvd.py
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/tools/recomp/test_lifter_wbinvd.py
@@ -0,0 +1,28 @@
+import unittest
+
+from .disasm import Instruction
+from .lifter import Lifter
+
+
+class WbinvdLifterTest(unittest.TestCase):
+    def test_wbinvd_emits_host_coherent_memory_fence(self):
+        instruction = Instruction(0x002954E4, 2, "wbinvd", "", "")
+        instruction.operands = []
+
+        self.assertEqual(
+            Lifter().lift_instruction(instruction),
+            ["RECOMP_WBINVD(); /* wbinvd: host-coherent memory only */"],
+        )
+
+    def test_wbinvd_is_not_counted_as_unimplemented(self):
+        instruction = Instruction(0x002954E4, 2, "wbinvd", "", "")
+        instruction.operands = []
+        lifter = Lifter()
+
+        lifter.lift_instruction(instruction)
+
+        self.assertNotIn("wbinvd", lifter.unimplemented)
+
+
+if __name__ == "__main__":
+    unittest.main()
