@@ -551,0 +552,9 @@ def _make_condition(jcc, flag_setter, flag_ops):
+    # AAA/AAS define only AF and CF. Their other arithmetic flags are
+    # undefined, so only simple carry conditions can be reconstructed.
+    if flag_setter in ("aaa", "aas"):
+        if jcc in ("jb", "jnae", "jc"):
+            return "_cf", desc
+        if jcc in ("jae", "jnb", "jnc"):
+            return "!_cf", desc
+        return None
+
@@ -1336 +1345 @@ class Lifter:
