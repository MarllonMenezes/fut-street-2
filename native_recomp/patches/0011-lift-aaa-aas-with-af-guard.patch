@@ -1710,0 +1721,17 @@ class Lifter:
+        if m in ("aaa", "aas"):
+            if (not self.needs_af
+                    or insn.address not in self.supported_ascii_adjust_sites):
+                return self._unimplemented(insn, m)
+            delta = "+" if m == "aaa" else "-"
+            out = [
+                "{ uint32_t _old_al = LO8(eax), _ax = LO16(eax);",
+                "  int _adjust = ((_old_al & 0x0Fu) > 9u) || _af;",
+                f"  if (_adjust) _ax {delta}= 0x0106u;",
+                "  _ax = (_ax & 0xFF00u) | (_ax & 0x000Fu);",
+                "  SET_LO16(eax, _ax); _af = _adjust;",
+            ]
+            if self.needs_cf:
+                out.append("  _cf = _adjust;")
+            out.append(f"}} /* {m}: ASCII adjust AX */")
+            return out
