+def test_real_init_sequence_lowers_write_without_register_changes():
+    insns = [
+        _insn(0x298028, "mov", [_reg("dx"), _imm(0x80C0)]),
+        _insn(0x29802C, "mov", [_reg("al"), _reg("bl")]),
+        _insn(0x29802E, "push", [_imm(4)]),
+        _insn(0x298030, "out", [_reg("dx"), _reg("al")]),
+    ]
+    lifter = Lifter()
+    lifter.supported_io_sites = FunctionTranslator._supported_io_sites(insns)
+    assert lifter.supported_io_sites == {0x298030}
+    assert lifter.lift_instruction(insns[-1]) == [
+        "recomp_xbox_io_write8(LO16(edx), LO8(eax)); /* out dx, al */"
+    ]
