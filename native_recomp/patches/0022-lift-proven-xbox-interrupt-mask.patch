diff --git a/tools/recomp/translator.py b/tools/recomp/translator.py
--- a/tools/recomp/translator.py
+++ b/tools/recomp/translator.py
@@ -1591,6 +1591,31 @@ class FunctionTranslator:
                     break
         return supported
 
+    @staticmethod
+    def _supported_interrupt_mask_sites(instructions):
+        """Find exact same-block CLI/STI pairs.
+
+        Independent Xbox compatibility evidence models both opcodes as a
+        process-wide interrupt-delivery mask.  Require a straight-line pair
+        before lowering: a branch, call, return, far jump, or software trap
+        could move the matching STI outside the critical section and would
+        need scheduler-level semantics that this no-emulation host does not
+        provide.
+        """
+        supported = set()
+        for index, insn in enumerate(instructions):
+            if insn.mnemonic != "cli":
+                continue
+            for candidate in instructions[index + 1:]:
+                if (candidate.is_branch or candidate.is_call
+                        or candidate.is_ret
+                        or candidate.mnemonic in ("ljmp", "int", "int3")):
+                    break
+                if candidate.mnemonic == "sti":
+                    supported.update((insn.address, candidate.address))
+                    break
+        return supported
+
     def _func_has_prologue(self, instructions):
         """Check if function starts with push ebp; mov ebp, esp."""
         if len(instructions) < 2:
@@ -2566,6 +2591,8 @@ class FunctionTranslator:
         self.lifter.supported_flag_save_sites = self._supported_flag_save_sites(
             instructions)
         self.lifter.supported_io_sites = self._supported_io_sites(instructions)
+        self.lifter.supported_interrupt_mask_sites = (
+            self._supported_interrupt_mask_sites(instructions))
         # DAA/DAS and AAA/AAS can each produce the flag consumed by the other.
         # Grow supported sites monotonically to a fixed point, while never
