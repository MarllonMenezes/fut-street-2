diff --git a/tools/recomp/test_lifter_interrupt_mask.py b/tools/recomp/test_lifter_interrupt_mask.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_lifter_interrupt_mask.py
@@ -0,0 +1,48 @@
+"""Only proven same-block CLI/STI pairs lower to host mask state."""
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+from .translator import FunctionTranslator
+
+
+def _insn(address, mnemonic, operands=(), size=1):
+    return Instruction(address, size, mnemonic, "", "", operands=list(operands))
+
+
+def test_same_block_cli_sti_pair_is_proven():
+    insns = [
+        _insn(0x100, "cli"),
+        _insn(0x101, "mov"),
+        _insn(0x102, "sti"),
+    ]
+
+    assert FunctionTranslator._supported_interrupt_mask_sites(insns) == {
+        0x100, 0x102
+    }
+
+
+def test_branch_prevents_pair_proof():
+    branch = _insn(0x201, "jmp", [Operand(type="imm", imm=0x300)])
+    insns = [
+        _insn(0x200, "cli"),
+        branch,
+        _insn(0x202, "sti"),
+    ]
+
+    assert FunctionTranslator._supported_interrupt_mask_sites(insns) == set()
+
+
+def test_unmatched_cli_and_sti_stay_visible():
+    insns = [_insn(0x300, "cli"), _insn(0x301, "ret")]
+    assert FunctionTranslator._supported_interrupt_mask_sites(insns) == set()
+
+
+def test_proven_pair_lowers_and_unproven_opcode_stays_visible():
+    lifter = Lifter()
+    lifter.supported_interrupt_mask_sites = {0x400, 0x401}
+
+    lowered_cli = " ".join(lifter.lift_instruction(_insn(0x400, "cli")))
+    lowered_sti = " ".join(lifter.lift_instruction(_insn(0x401, "sti")))
+    assert "recomp_xbox_cli()" in lowered_cli
+    assert "recomp_xbox_sti()" in lowered_sti
+    assert "RECOMP_UNIMPL" not in lowered_cli + lowered_sti
+
+    unresolved = " ".join(lifter.lift_instruction(_insn(0x402, "cli")))
+    assert "RECOMP_UNIMPL" in unresolved
