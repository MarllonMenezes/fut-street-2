diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -4451,9 +4451,10 @@ static void bridge_KeAlertThread(void)
 
 /* ── KeWaitForMultipleObjects (ordinal 158, 8 args)
  *
- * KeWaitForSingleObject is routed; the multiple-object sibling was not. Like
- * NtWaitForMultipleObjectsEx, the Objects[] array in guest memory holds 32-bit
- * handle tokens, so each is resolved before the native wait sees it. */
+ * Objects[] contains guest dispatcher-object addresses, unlike the HANDLE
+ * token array accepted by NtWaitForMultipleObjectsEx. Resolve shadow objects
+ * first; optionally adapt title-built notification/synchronization events via
+ * ke_guest_event, matching the single-object wait path. */
 #define BRIDGE_MAXIMUM_WAIT_OBJECTS 64
 
 static void bridge_KeWaitForMultipleObjects(void)
@@ -4464,6 +4465,8 @@ static void bridge_KeWaitForMultipleObjects(void)
     uint32_t alertable  = STACK_ARG(5);   /* 3=WaitReason, 4=WaitMode */
     uint32_t timeout_va = STACK_ARG(6);
     HANDLE handles[BRIDGE_MAXIMUM_WAIT_OBJECTS];
+    uint32_t guest_events[BRIDGE_MAXIMUM_WAIT_OBJECTS] = {0};
+    int guest_event_types[BRIDGE_MAXIMUM_WAIT_OBJECTS] = {0};
     uint32_t i;
 
     if (count == 0) {
@@ -4472,15 +4475,43 @@ static void bridge_KeWaitForMultipleObjects(void)
     }
     if (count > BRIDGE_MAXIMUM_WAIT_OBJECTS)
         count = BRIDGE_MAXIMUM_WAIT_OBJECTS;
-    for (i = 0; i < count; i++)
-        handles[i] = bridge_resolve_handle(
-            objects_va ? BRIDGE_MEM32(objects_va + i * 4) : 0);
+    for (i = 0; i < count; i++) {
+        uint32_t object_va = objects_va ? BRIDGE_MEM32(objects_va + i * 4) : 0;
+        handles[i] = ke_shadow_lookup(object_va);
+        if (!handles[i]) {
+            int event_type = 0;
+            HANDLE guest_event = ke_guest_event(object_va, &event_type);
+            if (guest_event) {
+                if (BRIDGE_MEM32(object_va + 4) == 0) {
+                    ResetEvent(guest_event);
+                    if (BRIDGE_MEM32(object_va + 4) != 0)
+                        SetEvent(guest_event);
+                } else {
+                    SetEvent(guest_event);
+                }
+                handles[i] = guest_event;
+                guest_events[i] = object_va;
+                guest_event_types[i] = event_type;
+            }
+        }
+        if (!handles[i])
+            handles[i] = bridge_resolve_handle(object_va);
+    }
 
     g_eax = (uint32_t)xbox_KeWaitForMultipleObjects(
         count, (PVOID *)handles, wait_type,
         STACK_ARG(3), (KPROCESSOR_MODE)STACK_ARG(4),
         (BOOLEAN)alertable, XBOX_TO_NATIVE(timeout_va),
         XBOX_TO_NATIVE(STACK_ARG(7)));
+
+    if (wait_type == 0 && g_eax == 0) {
+        for (i = 0; i < count; i++)
+            if (guest_events[i] && guest_event_types[i] == 1)
+                BRIDGE_MEM32(guest_events[i] + 4) = 0;
+    } else if (g_eax < count && guest_events[g_eax] &&
+               guest_event_types[g_eax] == 1) {
+        BRIDGE_MEM32(guest_events[g_eax] + 4) = 0;
+    }
 }
 
 #undef BRIDGE_MAXIMUM_WAIT_OBJECTS
