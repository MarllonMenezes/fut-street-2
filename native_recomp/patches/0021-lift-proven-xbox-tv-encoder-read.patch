+
+    @staticmethod
+    def _supported_io_sites(instructions):
+        """Find only Xbox TV-encoder byte reads with a proven port setup.
+
+        The current image uses ``mov dx, 0x80C0; in al, dx`` to sample the
+        Xbox TV encoder's field-pin status.  A preceding write to DX must be
+        the immediate port constant in the same straight-line block; any
+        other DX write or control-transfer boundary invalidates the proof.
+        OUT remains unresolved because its device-side effect is not proven.
+        """
+        supported = set()
+        for index, insn in enumerate(instructions):
+            if (insn.mnemonic != "in" or len(insn.operands) != 2
+                    or insn.operands[0].type != "reg"
+                    or insn.operands[0].reg != "al"
+                    or insn.operands[1].type != "reg"
+                    or insn.operands[1].reg != "dx"):
+                continue
+
+            for previous in reversed(instructions[:index]):
+                if (previous.is_branch or previous.is_call or previous.is_ret
+                        or previous.mnemonic in ("ljmp", "int", "int3")):
+                    break
+                if (previous.mnemonic == "mov"
+                        and len(previous.operands) == 2
+                        and previous.operands[0].type == "reg"
+                        and previous.operands[0].reg == "dx"):
+                    source = previous.operands[1]
+                    if (source.type == "imm"
+                            and (source.imm & 0xFFFF) == 0x80C0):
+                        supported.add(insn.address)
+                    break
+                if "dx" in previous.regs_written:
+                    break
+        return supported
 
     def _func_has_prologue(self, instructions):
