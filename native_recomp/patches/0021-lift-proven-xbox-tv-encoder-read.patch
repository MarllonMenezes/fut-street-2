diff --git a/tools/recomp/test_lifter_io_port.py b/tools/recomp/test_lifter_io_port.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_lifter_io_port.py
@@ -0,0 +1,66 @@
+"""Only proven Xbox TV-encoder byte reads may lower from IN AL, DX."""
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+from .translator import FunctionTranslator
+
+
+def _insn(address, mnemonic, operands=(), size=1):
+    return Instruction(address, size, mnemonic, "", "", operands=list(operands))
+
+
+def _reg(name):
+    return Operand(type="reg", reg=name)
+
+
+def _imm(value):
+    return Operand(type="imm", imm=value)
+
+
+def test_only_same_block_80c0_in_reads_are_proven():
+    insns = [
+        _insn(0x100, "mov", [_reg("dx"), _imm(0x80C0)]),
+        _insn(0x101, "in", [_reg("al"), _reg("dx")]),
+        _insn(0x102, "out", [_reg("dx"), _reg("al")]),
+    ]
+
+    assert FunctionTranslator._supported_io_sites(insns) == {0x101}
+
+
+def test_other_dx_write_invalidates_the_port_proof():
+    insns = [
+        _insn(0x200, "mov", [_reg("dx"), _imm(0x80C0)]),
+        _insn(0x201, "mov", [_reg("dx"), _imm(0x1234)]),
+        _insn(0x202, "in", [_reg("al"), _reg("dx")]),
+    ]
+
+    assert FunctionTranslator._supported_io_sites(insns) == set()
+
+
+def test_control_transfer_invalidates_the_port_proof():
+    branch = _insn(0x300, "jmp", [_imm(0x400)])
+    insns = [
+        _insn(0x2FE, "mov", [_reg("dx"), _imm(0x80C0)]),
+        branch,
+        _insn(0x301, "in", [_reg("al"), _reg("dx")]),
+    ]
+
+    assert FunctionTranslator._supported_io_sites(insns) == set()
+
+
+def test_proven_read_lowers_and_unproven_read_stays_visible():
+    lifter = Lifter()
+    lifter.supported_io_sites = {0x500}
+    lowered = " ".join(
+        lifter.lift_instruction(
+            _insn(0x500, "in", [_reg("al"), _reg("dx")])
+        )
+    )
+    assert "recomp_xbox_io_read8(LO16(edx))" in lowered
+    assert "RECOMP_UNIMPL" not in lowered
+
+    unresolved = " ".join(
+        lifter.lift_instruction(
+            _insn(0x501, "out", [_reg("dx"), _reg("al")])
+        )
+    )
+    assert "RECOMP_UNIMPL" in unresolved
